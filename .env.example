# MongoDB connection URI (optional - CineSuggest has an integrated resilient in-memory fallback store if local/remote MongoDB is not running)
MONGODB_URI=

# Secret key used for signing and verifying JWT tokens
JWT_SECRET=cinesuggest_super_secret_jwt_key_2026

# TMDB API Key for live trending, popular, search, and movie metadata
# CineSuggest includes a high-quality fallback catalog if no key is configured
TMDB_API_KEY=

# Google Gemini API key for natural language movie query understanding and AI insights
GEMINI_API_KEY=

# Server port (defaults to 3000 in cloud environment, or 5000 locally)
PORT=5000
